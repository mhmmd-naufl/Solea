# Base URL backend FastAPI (lokal)
# Opsi A: pakai proxy Vite (biarkan kosong, default ke /api via proxy)
# Opsi B: isi URL absolut kalau backend jalan di mesin/server lain
# Aplikasi ini memakai port 8001 supaya tidak bentrok dengan backend lain
# di mesin yang sama. Kalau dua backend merebut satu port, frontend diam-diam
# memakai API aplikasi yang salah dan error-nya muncul sebagai "Not Found".
VITE_API_BASE_URL=http://127.0.0.1:8001

# Nama aplikasi/usaha yang tampil di UI. Boleh diganti sesuai kebutuhan.
VITE_BUSINESS_NAME=Solea

# Supabase (opsional — hanya bila frontend mau Realtime langsung)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
